# Template for the local .env file, which is not tracked by git.
# Copy it before starting the stack:
#   cp .env.example .env        (Linux/macOS)
#   Copy-Item .env.example .env (Windows PowerShell)
# The values below are the working defaults; adjust ports if they clash on your machine.

# --- Kafka ---
KAFKA_TOPIC=binance.trades.raw
KAFKA_PARTITIONS=3
# Port used by clients running on the host (producer/scripts on Windows)
KAFKA_EXTERNAL_PORT=29092

# --- Mongo ---
# Host port is 27018 because the dev machine's native MongoDB 8.2 already uses 27017
MONGO_PORT=27018
MONGO_DB=realtime
MONGO_COLLECTION=trade_ohlc

# --- Kafka UI ---
KAFKA_UI_PORT=8080

# --- Producer (used from step 2 on) ---
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
POLL_INTERVAL_SEC=2
# Broker address for the producer. From the host use the EXTERNAL listener;
# once the producer is containerized (step 6) this becomes kafka:9092.
KAFKA_BOOTSTRAP=localhost:29092
