# Pipeline configuration. No secrets here; keeping it in the repo is deliberate
# so that moving to the Linux box only means editing this one file.

# --- Kafka ---
KAFKA_TOPIC=binance.trades.raw
KAFKA_PARTITIONS=3
# Port used by clients running on the host (producer/scripts on Windows)
KAFKA_EXTERNAL_PORT=29092

# --- Mongo ---
# Host port is 27018 because the machine's native MongoDB 8.2 already uses 27017
MONGO_PORT=27018
MONGO_DB=realtime
MONGO_COLLECTION=trade_ohlc

# --- Kafka UI ---
KAFKA_UI_PORT=8080

# --- Producer (used from step 2 on) ---
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
POLL_INTERVAL_SEC=2
